# Generated by personal-cloud ship — do not edit by hand
# API + MinIO (S3) on an internal network; API also on edge for Caddy.
# MinIO ports are published on the VM for Tailscale clients (presigned URLs).
name: ${APP_NAME}

services:
  minio:
    image: docker.io/minio/minio:latest
    container_name: ${APP_NAME}-minio
    command: server /data --console-address ":9001"
    restart: unless-stopped
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    volumes:
      - ${DATA_HOST_PATH}/minio:/data
    ports:
      - "9000:9000"
      - "9001:9001"
    networks:
      - internal

  minio-init:
    image: docker.io/minio/mc:latest
    depends_on:
      - minio
    entrypoint: >
      /bin/sh -c "
      set -e;
      for i in $$(seq 1 30); do
        mc alias set local http://minio:9000 $${MINIO_ROOT_USER} $${MINIO_ROOT_PASSWORD} && break;
        sleep 1;
      done;
      mc mb --ignore-existing local/$${MINIO_BUCKET};
      mc anonymous set none local/$${MINIO_BUCKET};
      echo 'bucket ready';
      "
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
      MINIO_BUCKET: ${MINIO_BUCKET}
    networks:
      - internal
    restart: "no"

  app:
    image: ${IMAGE}:${IMAGE_TAG}
    container_name: ${SERVICE_CONTAINER}
    restart: unless-stopped
    env_file:
      - .env
    environment:
      MINIO_ENDPOINT: http://minio:9000
      BUCKET: ${MINIO_BUCKET}
      MINIO_ACCESS_KEY: ${MINIO_ROOT_USER}
      MINIO_SECRET_KEY: ${MINIO_ROOT_PASSWORD}
    volumes:
      - ${DATA_HOST_PATH}/api:/data
    depends_on:
      - minio
      - minio-init
    healthcheck:
      test: ["CMD-SHELL", "timeout 1 bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/${SERVICE_PORT}' || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    networks:
      - internal
      - edge

networks:
  internal:
    name: ${APP_NAME}_internal
  edge:
    external: true
    name: personal-cloud_edge
