# Generated by personal-cloud ship — do not edit by hand
# Forgejo: HTTP on the edge network (Caddy) plus host-published HTTP/SSH.
# GIT_BIND / GIT_HTTP_PORT / GIT_SSH_PORT come from apps/<name>/.env
# (compose interpolation, not envsubst — keep those names off render-app.sh).
# Bind GIT_BIND to Tailscale or 127.0.0.1. Do not publish 0.0.0.0 without a WAN deny.
name: ${APP_NAME}

services:
  app:
    image: ${IMAGE}:${IMAGE_TAG}
    container_name: ${SERVICE_CONTAINER}
    restart: unless-stopped
    stop_grace_period: 30s
    env_file:
      - .env
    volumes:
      - ${DATA_HOST_PATH}:/data
    ports:
      - "${GIT_BIND:-127.0.0.1}:${GIT_HTTP_PORT:-8050}:${SERVICE_PORT}"
      - "${GIT_BIND:-127.0.0.1}:${GIT_SSH_PORT:-2222}:2222"
    healthcheck:
      test: ["CMD-SHELL", "timeout 1 bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/${SERVICE_PORT}' || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - edge

networks:
  edge:
    external: true
    name: personal-cloud_edge
