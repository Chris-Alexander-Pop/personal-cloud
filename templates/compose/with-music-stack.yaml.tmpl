# Generated by personal-cloud ship — do not edit by hand
# Ingest (this image) + Navidrome + dufs + phone-edge Caddy.
# Profile `acquire`: lidarr + slskd + soularr. Profile `usenet`: sabnzbd (also set acquire).
# MUSIC_BIND / DUFS_AUTH / SLSKD_* / LIDARR_API_KEY / COMPOSE_PROFILES are
# interpolated by Compose from apps/<name>/.env (not envsubst — keep those names
# off render-app.sh's substitution list).
name: ${APP_NAME}

services:
  navidrome:
    image: docker.io/deluan/navidrome:latest
    container_name: ${APP_NAME}-navidrome
    restart: unless-stopped
    user: "1000:1000"
    environment:
      ND_MUSICFOLDER: /music
      ND_DATAFOLDER: /data
      ND_PLAYLISTSPATH: /playlists
      ND_SCANSCHEDULE: "@every 1h"
      ND_LOGLEVEL: info
      ND_ENABLEDOWNLOADS: "false"
      ND_BASEURL: ""
    volumes:
      - ${DATA_HOST_PATH}/navidrome:/data
      - ${DATA_HOST_PATH}/library:/music:ro
      - ${DATA_HOST_PATH}/playlists:/playlists
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:4533/ping"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - internal
      - edge

  dufs:
    image: docker.io/sigoden/dufs:latest
    container_name: ${APP_NAME}-dav
    restart: unless-stopped
    user: "1000:1000"
    command:
      - /share
      - --bind
      - 0.0.0.0
      - --port
      - "5000"
      - --allow-upload
      - --allow-delete
      - --allow-search
      - --allow-archive
      - --auth
      - "${DUFS_AUTH}"
    volumes:
      - ${DATA_HOST_PATH}/library:/share/library
      - ${DATA_HOST_PATH}/views:/share/views
      - ${DATA_HOST_PATH}/incoming:/share/incoming
      - ${DATA_HOST_PATH}/playlists:/share/playlists
      - ${DATA_HOST_PATH}/namida-backups:/share/namida-backups
    networks:
      - internal
      - edge

  ingest:
    image: ${IMAGE}:${IMAGE_TAG}
    container_name: ${SERVICE_CONTAINER}
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - ${DATA_HOST_PATH}:/data
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${SERVICE_PORT}/health')"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
    depends_on:
      navidrome:
        condition: service_started
      dufs:
        condition: service_started
    networks:
      - internal
      - edge

  edge:
    image: docker.io/library/caddy:2-alpine
    container_name: ${APP_NAME}-edge
    restart: unless-stopped
    ports:
      - "${MUSIC_BIND:-127.0.0.1}:8040:8040"
      - "${MUSIC_BIND:-127.0.0.1}:8041:8041"
      - "${MUSIC_BIND:-127.0.0.1}:8042:8042"
      - "${MUSIC_BIND:-127.0.0.1}:8043:8043"
      - "${MUSIC_BIND:-127.0.0.1}:8044:8044"
      - "${MUSIC_BIND:-127.0.0.1}:8045:8045"
    volumes:
      - /opt/personal-cloud/templates/caddy/with-music-stack.Caddyfile:/etc/caddy/Caddyfile:ro
    depends_on:
      - navidrome
      - dufs
      - ingest
    networks:
      - internal

  lidarr:
    profiles: ["acquire"]
    image: lscr.io/linuxserver/lidarr:latest
    container_name: ${APP_NAME}-lidarr
    restart: unless-stopped
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: UTC
    volumes:
      - ${DATA_HOST_PATH}/clients/lidarr/config:/config
      - ${DATA_HOST_PATH}/clients/lidarr/imported:/music
      - ${DATA_HOST_PATH}/clients/slskd/downloads:/slskd-downloads
      - ${DATA_HOST_PATH}/clients/sabnzbd/complete:/sabnzbd-complete
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8686/ping"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 60s
    networks:
      - internal

  slskd:
    profiles: ["acquire"]
    image: docker.io/slskd/slskd:latest
    container_name: ${APP_NAME}-slskd
    restart: unless-stopped
    user: "1000:1000"
    environment:
      SLSKD_SLSK_USERNAME: "${SLSKD_SLSK_USERNAME}"
      SLSKD_SLSK_PASSWORD: "${SLSKD_SLSK_PASSWORD}"
      SLSKD_USERNAME: "${SLSKD_USERNAME}"
      SLSKD_PASSWORD: "${SLSKD_PASSWORD}"
      SLSKD_API_KEY: "${SLSKD_API_KEY}"
      SLSKD_SLSK_LISTEN_PORT: "${SLSKD_LISTEN_PORT:-50300}"
      SLSKD_DOWNLOADS_DIR: /downloads
      SLSKD_INCOMPLETE_DIR: /incomplete
      SLSKD_SHARED_DIR: /share
      SLSKD_REMOTE_CONFIGURATION: "false"
      SLSKD_REMOTE_FILE_MANAGEMENT: "true"
    ports:
      - "0.0.0.0:${SLSKD_LISTEN_PORT:-50300}:${SLSKD_LISTEN_PORT:-50300}"
    volumes:
      - ${DATA_HOST_PATH}/clients/slskd/config:/app
      - ${DATA_HOST_PATH}/clients/slskd/downloads:/downloads
      - ${DATA_HOST_PATH}/clients/slskd/incomplete:/incomplete
      - ${DATA_HOST_PATH}/clients/slskd/share:/share
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:5030/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 40s
    networks:
      - internal

  soularr:
    profiles: ["acquire"]
    image: docker.io/mrusse08/soularr:latest
    container_name: ${APP_NAME}-soularr
    restart: unless-stopped
    user: "1000:1000"
    environment:
      TZ: UTC
      SCRIPT_INTERVAL: "300"
      WEBUI_ENABLED: "false"
    volumes:
      - ${DATA_HOST_PATH}/clients/soularr:/data
      - ${DATA_HOST_PATH}/clients/slskd/downloads:/downloads
    depends_on:
      lidarr:
        condition: service_healthy
      slskd:
        condition: service_healthy
    networks:
      - internal

  sabnzbd:
    profiles: ["usenet"]
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: ${APP_NAME}-sabnzbd
    restart: unless-stopped
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: UTC
    volumes:
      - ${DATA_HOST_PATH}/clients/sabnzbd/config:/config
      - ${DATA_HOST_PATH}/clients/sabnzbd/incomplete:/incomplete
      - ${DATA_HOST_PATH}/clients/sabnzbd/complete:/complete
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8080/"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 40s
    networks:
      - internal

networks:
  internal:
    name: ${APP_NAME}_internal
  edge:
    external: true
    name: personal-cloud_edge
