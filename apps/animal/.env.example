# Copy to .env on the VM: /opt/personal-cloud/apps/animal/.env
# Or: pc env init && edit ~/.config/pc/env/animal.env && pc env push
# chmod 600 .env
# Do not commit real values.

IMAGE_TAG=latest

# Injected into Postgres by the with-postgres compose template.
POSTGRES_PASSWORD=change-me-long-random

# HMAC key for access JWTs. Must be at least 32 characters.
# Rejected if empty or a known placeholder (e.g. dev-only-change-in-production).
JWT_SIGNING_KEY=change-me-must-be-at-least-32-chars-long

# AI providers — Gemini is primary when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VISION_MODEL=gemini-3.7-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

MONTHLY_COST_CAP=10.00
MEDIA_ROOT=/tmp/animal-media

# Tests only — never enable on the VM.
# ANIMAL_ALLOW_INSECURE_JWT=1
