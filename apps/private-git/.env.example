# Copy to .env on the VM: /opt/personal-cloud/apps/private-git/.env
# Or: pc env init && edit ~/.config/pc/env/private-git.env && pc env push
# chmod 600 .env

IMAGE_TAG=latest
DATA_HOST_PATH=/opt/personal-cloud/data/private-git

# Bind HTTP :8050 and SSH :2222. Tailscale IP of deploy, or 127.0.0.1 + Tailscale serve.
# Do not use 0.0.0.0 unless ufw-deny 8050/2222 from WAN.
GIT_BIND=127.0.0.1
GIT_HTTP_PORT=8050
GIT_SSH_PORT=2222

USER_UID=1000
USER_GID=1000

# Clone URLs in the UI. After env init, set these to the same host as GIT_BIND
# (Tailscale IP or a name that resolves to it). Keep HTTP if you skip Caddy's internal CA.
FORGEJO__server__PROTOCOL=http
FORGEJO__server__DOMAIN=127.0.0.1
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__ROOT_URL=http://127.0.0.1:8050/
FORGEJO__server__SSH_DOMAIN=127.0.0.1
# Official image already runs sshd on 22 (mapped to GIT_SSH_PORT on the host).
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__server__SSH_PORT=2222
FORGEJO__server__LFS_START_SERVER=true

FORGEJO__database__DB_TYPE=sqlite3

FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__SHOW_REGISTRATION_BUTTON=false
FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION=false

FORGEJO__repository__ENABLE_PUSH_CREATE_USER=true
FORGEJO__repository__DEFAULT_PUSH_CREATE_PRIVATE=true

FORGEJO__openid__ENABLE_OPENID_SIGNIN=false
FORGEJO__openid__ENABLE_OPENID_SIGNUP=false
FORGEJO__picture__DISABLE_GRAVATAR=true
FORGEJO__picture__ENABLE_FEDERATED_AVATAR=false
FORGEJO__actions__ENABLED=false

# First boot: leave false, create the admin in the UI, then set true and re-push env.
FORGEJO__security__INSTALL_LOCK=false
