# Copy to .env on the VM: /opt/personal-cloud/apps/music-serve/.env
# Or: pc env init && edit ~/.config/pc/env/music-serve.env && pc env push
# chmod 600 .env

IMAGE_TAG=latest
DATA_HOST_PATH=/opt/personal-cloud/data/music-serve

# Bind phone-edge + acquire UI ports. Tailscale IP of deploy, or 127.0.0.1 + Tailscale serve.
# Do not use 0.0.0.0 unless ufw-deny 8040-8045 from WAN (not the Soulseek listen port).
MUSIC_BIND=127.0.0.1

# FastAPI auth (X-API-Key) for ingest except GET /health.
# Generate: openssl rand -hex 24
INGEST_API_KEY=change-me-long-random
INGEST_DISK_FLOOR_GB=20
NAVIDROME_URL=http://navidrome:4533

# dufs --auth (owner read-write on the share root).
# Example: chris:password@/:rw
# Guests: extra rules like guest:password@/views/romanian:ro
DUFS_AUTH=chris:change-me@/:rw

# Navidrome creates the first admin in the UI on :8040. Do not enable anonymous.
# Optional: ND_LASTFM_APIKEY=  ND_LASTFM_SECRET=

# Phase 6a acquire (music_serve docs/ACQUIRE.md). Grow disk first. Empty Soulseek
# creds: slskd stays logged out until you fill them. Lidarr API key comes from
# the Lidarr UI after first boot — then pc env push and restart soularr/ingest.
COMPOSE_PROFILES=acquire
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
SLSKD_USERNAME=chris
SLSKD_PASSWORD=change-me
SLSKD_API_KEY=
SLSKD_LISTEN_PORT=50300
LIDARR_API_KEY=
# LIDARR_UI_URL=http://100.x.x.x:8045
# ACOUSTID_API_KEY=
# INGEST_ACOUSTID=0
# INGEST_COVERS=0
# Later, with Usenet keys (do not enable empty):
# COMPOSE_PROFILES=acquire,usenet
# SABNZBD_API_KEY=
# USENET_HOST=
# USENET_PORT=563
# USENET_SSL=1
# USENET_USER=
# USENET_PASSWORD=
# USENET_CONNECTIONS=10
# NEWZNAB_URL=
# NEWZNAB_API_KEY=
