# Copy to .env on the VM: /opt/personal-cloud/apps/third-eye/.env
# Or: pc env init && edit ~/.config/pc/env/third-eye.env && pc env push
# chmod 600 .env

IMAGE_TAG=latest

# FastAPI auth (X-API-Key). Generate: openssl rand -hex 24
API_KEY=change-me-long-random

# MinIO root credentials (also used as S3 access keys by the API)
MINIO_ROOT_USER=third-eye
MINIO_ROOT_PASSWORD=change-me-long-random
MINIO_BUCKET=third-eye

# Host-reachable endpoint baked into presigned clip URLs.
# Phone must reach this over Tailscale (split tunnel allowed for the VM).
MINIO_PUBLIC_ENDPOINT=http://100.x.x.x:9000
MINIO_REGION=us-east-1
PRESIGN_EXPIRES_SEC=3600

DATABASE_URL=sqlite:////data/third-eye.db
